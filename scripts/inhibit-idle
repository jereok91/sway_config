#!/usr/bin/env sh
# Evita el bloqueo/suspensión parando swayidle durante X minutos.
# swayidle ignora los bloqueos de systemd-inhibit, así que paramos el servicio
# y un timer transitorio de systemd lo vuelve a arrancar al acabar el tiempo.

TIMER=swayidle-inhibit
SIGNAL="$HOME/.config/sway/scripts/waybar-signal"

status() {
    ! systemctl --user is-active -q swayidle.service
}

resume() {
    systemctl --user stop "$TIMER.timer" 2>/dev/null
    systemctl --user start swayidle.service
    "$SIGNAL" idle
}

inhibit() {
    systemctl --user stop "$TIMER.timer" 2>/dev/null
    systemctl --user stop swayidle.service
    if [ -n "$1" ]; then
        systemd-run --user --quiet --unit="$TIMER" --on-calendar="$(date -d "+$1" "+%F %T")" \
            sh -c "systemctl --user start swayidle.service; $SIGNAL idle"
    fi
    "$SIGNAL" idle
}

case $1'' in
'interactive')
    MINUTES=$(printf "10\n15\n20\n30\n45\n60\n90\n120\nUnlimited" | rofi -dmenu -p "Minutes without idle/lock:")
    case "$MINUTES" in
    '') ;;
    'Unlimited') inhibit ;;
    *[!0-9]*) notify-send "Idle" "Invalid value: $MINUTES" ;;
    *) inhibit "$MINUTES minutes" ;;
    esac
    ;;
'off')
    resume
    ;;
esac

# Returns data for Waybar
if status; then
    class="on"
    until=$(systemctl --user show "$TIMER.timer" -p NextElapseUSecRealtime --value 2>/dev/null)
    if [ -n "$until" ] && [ "$until" != "n/a" ]; then
        text="Idle inhibited until $(date -d "$until" +%H:%M) (Mid click to clear)"
    else
        text="Idle inhibited, no time limit (Mid click to clear)"
    fi
else
    class="off"
    text="Idle not inhibited"
fi

printf '{"alt":"%s","tooltip":"%s"}\n' "$class" "$text"
