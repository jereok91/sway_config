[Unit]
Description=Sway idle manager
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Los tiempos se configuran en ~/.config/sway/idle.conf
ExecStart=%h/.config/sway/scripts/swayidle.sh
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
